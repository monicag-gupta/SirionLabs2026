  const [count, setCount] = useState(0);
  useEffect(() => {
    let timer = setTimeout(() => {
        setCount((count) => count + 1);
    }, 1000);
    return () => {clearTimeout(timer);console.log("Component Unmounted");}
  }, []);
  return <h1>I've rendered {count} times!</h1>;
}
