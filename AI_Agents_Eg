Output_parserEg.py

from langchain_core.output_parsers import StrOutputParser
from langchain_core.prompts import ChatPromptTemplate
from langchain_openai import ChatOpenAI
from dotenv import load_dotenv

load_dotenv()
prompt = ChatPromptTemplate.from_template(
    "Explain {topic} in one sentence."
)

model = ChatOpenAI(model="gpt-4.1-mini")
parser = StrOutputParser()

chain = prompt | model | parser

result = chain.invoke(
    {"topic": "vector databases"}
)

print(result)







Structured_outputEg.py

from pydantic import BaseModel
from langchain_openai import ChatOpenAI
from dotenv import load_dotenv

load_dotenv()
class CourseInformation(BaseModel):
    course_name: str
    duration_hours: int
    level: str

model = ChatOpenAI(model="gpt-4.1-mini")
structured_model = model.with_structured_output(
    CourseInformation
)
result = structured_model.invoke(
    "Create information for a beginner LangChain course."
)
print(result)

# with_structured_output() can return data matching a declared schema rather than unstructured text.





