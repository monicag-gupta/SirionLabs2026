SequentialChainsEg.py

from langchain_core.output_parsers import StrOutputParser
from langchain_core.prompts import ChatPromptTemplate
from langchain_openai import ChatOpenAI
from dotenv import load_dotenv

load_dotenv()
model = ChatOpenAI(model="gpt-4.1-mini")
parser = StrOutputParser()
explanation_prompt = ChatPromptTemplate.from_template(
    """
    Explain {topic} in approximately 100 words.
    """
)
explanation_chain = (explanation_prompt | model | parser)
quiz_prompt = ChatPromptTemplate.from_template(
    """
    Create three multiple-choice questions based on
    the following explanation:

    {explanation}
    """
)
quiz_chain = (quiz_prompt | model | parser)
sequential_chain = ({"explanation": explanation_chain} | quiz_chain)
result = sequential_chain.invoke({"topic": "Retrieval-Augmented Generation"})
print(result)





