The API does not automatically remember previous requests. 
The application must send the relevant previous messages again.

messages = [
    {"role": "system", "content": "You are a helpful AI trainer." },
    {"role": "user", "content": "What is Generative AI?" }
]
response = client.chat.completions.create(
    model="gpt-5-mini", messages=messages )
assistant_reply = response.choices[0].message.content

messages.append({ "role": "assistant", "content": assistant_reply })
messages.append({ "role": "user", "content": "Give me three business examples." })

second_response = client.chat.completions.create(
    model="gpt-5-mini",  messages=messages )
print(second_response.choices[0].message.content)









import os
from typing import Literal

from dotenv import load_dotenv
from openai import OpenAI
from pydantic import BaseModel

# Load environment variables
load_dotenv()

api_key = os.getenv("OPENAI_API_KEY")

if not api_key:
    raise ValueError("OPENAI_API_KEY is missing from the .env file.")

# Create OpenAI client
client = OpenAI(api_key=api_key)


# Define the required structured output
class CustomerRequest(BaseModel):
    sentiment: Literal["positive", "neutral", "negative"]
    request_type: str
    priority: Literal["low", "medium", "high"]
    summary: str


try:
    response = client.responses.parse(
        model="gpt-4.1-mini",
        input=[
            {
                "role": "system",
                "content": (
                    "Analyse customer messages and return the requested "
                    "structured information."
                ),
            },
            {
                "role": "user",
                "content": (
                    "I have been waiting for my refund for two weeks. "
                    "Please resolve it immediately."
                ),
            },
        ],
        text_format=CustomerRequest,
    )

    data = response.output_parsed

    print(data.model_dump())

    print("Sentiment   :", data.sentiment)
    print("Request Type:", data.request_type)
    print("Priority    :", data.priority)
    print("Summary     :", data.summary)

finally:
    client.close()



































