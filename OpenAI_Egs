import os
from typing import Literal
from dotenv import load_dotenv
from openai import OpenAI
from google.genai import types
from pydantic import BaseModel

# Load environment variables
load_dotenv()
api_key = os.getenv("OPENAI_API_KEY")
if not api_key:
    raise ValueError("OPENAI_API_KEY is missing from the .env file.")
# Define the required structured output
class CustomerRequest(BaseModel):
    sentiment: Literal["positive", "neutral", "negative"]
    request_type: str
    priority: Literal["low", "medium", "high"]
    summary: str

# Create Gemini client
client = genai.Client(api_key=api_key)
try:
    response = client.models.generate_content(
        model="gpt-4.1-mini",
        contents=("I have been waiting for my refund for two weeks. "
            "Please resolve it immediately."),
        config=types.GenerateContentConfig(
            system_instruction=(
                "Analyse customer messages and return "
                "the requested structured information."
            ),
            response_mime_type="application/json",
            response_schema=CustomerRequest
        )
    )
    # Validate the JSON response using the Pydantic model
    data = CustomerRequest.model_validate_json(response.text)
    print(data.model_dump())
    print("Sentiment:", data.sentiment)
    print("Request type:", data.request_type)
    print("Priority:", data.priority)
    print("Summary:", data.summary)
finally:
    client.close()







import os
from openai import OpenAI
from openai import APIConnectionError, AuthenticationError, RateLimitError
from dotenv import load_dotenv

load_dotenv()
def main() -> None:
    """Generate a short tagline using the OpenAI Responses API."""
    if not os.getenv("OPENAI_API_KEY"):
        print("Error: OPENAI_API_KEY is not configured.")
        print("Set the API key and restart the terminal.")
        return
    client = OpenAI()
    try:
        response = client.responses.create(
            model="gpt-4.1-mini",
            input="Write one creative tagline for an AI-powered learning platform.",
            temperature=0.7,
            max_output_tokens=50,
        )
        print("\nGenerated tagline:")
        print(response.output_text)
    except AuthenticationError:
        print("Authentication failed. Check your OPENAI_API_KEY.")
    except RateLimitError:
        print("The request could not be processed because of a rate limit "
              "or insufficient API quota. Check your API billing and usage.")
    except APIConnectionError:
        print("Could not connect to OpenAI. Check your internet connection.")
    except Exception as error:
        print(f"Unexpected error: {error}")

if __name__ == "__main__":
    main()

